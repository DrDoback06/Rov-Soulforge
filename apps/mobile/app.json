{
  "expo": {
    "name": "Realm of Valor",
    "slug": "realm-of-valor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.realmofvalor.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Realm of Valor uses your location to spawn nearby quests and adventures.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Realm of Valor uses your location to spawn nearby quests and adventures.",
        "NSHealthShareUsageDescription": "Realm of Valor integrates with HealthKit to track your fitness progress for in-game challenges."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACTIVITY_RECOGNITION"
      ],
      "package": "com.realmofvalor.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsDownloadToken": "pk.eyJ1IjoiZHJkb2JhY2swNiIsImEiOiJjbWc2eXVpbGowZ3VrMmlzZHR5Y2tmbXQ1In0.PznVbW_JjKO2GbEk6xDUNA"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "realmofvalor",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/your-project-id"
    },
    "extra": {
      "router": {
        "origin": false,
        "root": "./app"
      },
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}