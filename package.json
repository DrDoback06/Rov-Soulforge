{
  "name": "realm-of-valor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @rov/* dev",
    "build": "pnpm --filter @rov/* build",
    "lint": "pnpm --filter @rov/* lint",
    "type-check": "pnpm --filter @rov/* type-check",
    "import-cards": "pnpm --filter @rov/importer start",
    "import:db": "pnpm --filter @rov/importer import:db",
    "mobile": "pnpm --filter mobile start",
    "backend": "pnpm --filter backend dev",
    "admin": "pnpm --filter admin dev",
    "firebase:deploy": "cd packages/firebase && firebase deploy",
    "firebase:emulators": "cd packages/firebase && firebase emulators:start"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}