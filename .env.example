# Realm of Valor Environment Configuration
# Copy this file to .env and fill in your values

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Firebase Admin (Backend only)
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Mapbox Configuration
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token

# Backend API
API_URL=http://localhost:3001
API_PORT=3001

# Database
FIRESTORE_EMULATOR_HOST=localhost:8080 # Optional, for local development

# External APIs
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
GARMIN_API_KEY=your_garmin_api_key
WHOOP_API_KEY=your_whoop_api_key

# In-App Purchases
# Apple
APP_STORE_SHARED_SECRET=your_app_store_shared_secret

# Google
GOOGLE_PLAY_SERVICE_ACCOUNT=./google-play-service-account.json

# Stripe (Web payments)
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Push Notifications
FCM_SERVER_KEY=your_fcm_server_key

# Environment
NODE_ENV=development
