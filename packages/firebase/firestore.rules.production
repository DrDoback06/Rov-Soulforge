rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isParticipant(battle) {
      return isAuthenticated() && request.auth.uid in battle.participants;
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own data
      allow read: if isOwner(userId);

      // Users can create their own user doc
      allow create: if isOwner(userId);

      // Users can update their own data (limited fields)
      allow update: if isOwner(userId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'createdAt']));
    }

    // Characters collection
    match /characters/{charId} {
      // Anyone can read characters (for viewing other players)
      allow read: if isAuthenticated();

      // Only owner can create their own characters
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;

      // Only owner can update their own characters
      // Prevent direct modification of sensitive fields (gold, counters) - use Cloud Functions
      allow update: if isOwner(resource.data.uid)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'uid', 'gold']));

      // Only owner can delete
      allow delete: if isOwner(resource.data.uid);
    }

    // Battles collection
    match /battles/{battleId} {
      // Participants can read battle state
      allow read: if isParticipant(resource.data);

      // Battle creation via Cloud Function only
      allow create: if false;

      // Battle updates via Cloud Function only (validates moves)
      allow update: if false;
    }

    // Static quests (permanent landmark quests)
    match /staticQuests/{questId} {
      // Anyone can read static quests
      allow read: if isAuthenticated();

      // Quest creation via Cloud Function/Admin only
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Active quests (spawned dynamically)
    match /activeQuests/{questId} {
      // Anyone can read active quests in their region
      allow read: if isAuthenticated();

      // Quest creation via Cloud Function only (spawn system)
      allow create: if false;

      // Quest completion via Cloud Function only
      allow update: if false;

      // Quest expiration via Cloud Function only
      allow delete: if false;
    }

    // Player quest progress
    match /questProgress/{progressId} {
      // Users can read their own quest progress
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Users can create quest progress when starting a quest
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      // Quest progress updates via Cloud Function only (validation)
      allow update: if false;

      // Allow users to abandon their own quests
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Activity events (fitness tracking)
    match /activityEvents/{eventId} {
      // Users can read their own activities
      allow read: if isOwner(resource.data.uid);

      // Users can submit their own activities
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;

      // Activity validation via Cloud Function only
      allow update: if false;
    }

    // Cards collection (global card definitions)
    match /cards/{cardId} {
      // Anyone can read cards
      allow read: if isAuthenticated();

      // Card creation via Admin only
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Stashes collection (shared account-wide storage)
    match /stashes/{userId} {
      // Users can read/write their own stash
      allow read, write: if isOwner(userId);
    }

    // Inventories collection (legacy - might be unused)
    match /inventories/{userId} {
      // Users can read/write their own inventory
      allow read, write: if isOwner(userId);
    }

    // Card inventory
    match /cardInventory/{userId} {
      // Users can read their own inventory
      allow read: if isOwner(userId);

      // Inventory updates via Cloud Function only (pack opening, trades)
      allow create, update: if false;
    }

    // Shop purchases
    match /purchases/{purchaseId} {
      // Users can read their own purchases
      allow read: if isOwner(resource.data.uid);

      // Purchases via Cloud Function only (IAP validation)
      allow create: if false;
    }

    // Friends/Social
    match /friendships/{friendshipId} {
      // Users can read friendships they're part of
      allow read: if isAuthenticated()
        && (request.auth.uid in resource.data.users);

      // Users can create friend requests
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.users;

      // Users can accept/decline friend requests
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.users;

      // Users can delete friendships they're part of
      allow delete: if isAuthenticated()
        && request.auth.uid in resource.data.users;
    }

    // Leaderboards (read-only for clients)
    match /leaderboards/{leaderboardId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Function only
    }

    // Global game config (read-only)
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin only
    }

    // Admin collection (read-only for admins)
    match /admin/{document=**} {
      allow read, write: if false; // Use Firebase Admin SDK
    }
  }
}
